    "meta": { "serverDescription": " " },
    "inbounds": [
      {
        "listen": "127.0.0.1",
        "port": 10808,
        "protocol": "socks",
        "settings": { "allowTransparent": false, "auth": "noauth", "udp": true },
        "sniffing": {
          "destOverride": ["http", "tls", "quic"],
          "enabled": true,
          "metadataOnly": false,
